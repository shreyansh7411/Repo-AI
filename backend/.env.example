PORT=5000
NODE_ENV=development
# Optional locally. In production, set DATABASE_URL and DB_SSL_MODE.
DATABASE_URL=
DB_SSL_MODE=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=repo-ai
DB_USER=postgres
DB_PASSWORD=

# Local CORS remains permissive. Set the exact HTTPS frontend origin in production.
CORS_ORIGIN=http://localhost:5173
# Stores repository clones locally; ephemeral storage may lose clone files on restart or redeployment.
# REPOSITORY_STORAGE_PATH=

# Generate a random secret of at least 32 bytes; do not commit the value.
AUTH_JWT_SECRET=
# Local development uses lax; Render-hosted frontend/backend origins require none.
AUTH_COOKIE_SAME_SITE=lax
# Set temporarily by the trusted operator for db:assign-legacy-owner, then remove.
# LEGACY_REPOSITORY_OWNER_ID=

# Required only for real embedding generation and semantic search.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.8-flash
MAX_CONTEXT_CHARS=24000

# Anonymous recruiter demo is disabled unless explicitly enabled.
DEMO_ENABLED=false
# Required when DEMO_ENABLED=true; use a random secret of at least 32 bytes.
DEMO_RATE_LIMIT_SECRET=
DEMO_SESSION_TTL_MINUTES=120
DEMO_MAX_ACTIVE_SESSIONS=10
DEMO_MAX_CONCURRENT_INDEXES=2
DEMO_MAX_REPO_SIZE_MB=100
DEMO_MAX_INDEX_DURATION_SECONDS=180
DEMO_MAX_FILES=2500
DEMO_MAX_FILESYSTEM_ENTRIES=25000
DEMO_MAX_FILE_SIZE_MB=5
DEMO_RATE_LIMIT_WINDOW_SECONDS=3600
DEMO_MAX_INDEX_REQUESTS_PER_WINDOW=3
DEMO_MAX_READ_REQUESTS_PER_WINDOW=120
DEMO_CLEANUP_INTERVAL_SECONDS=60
