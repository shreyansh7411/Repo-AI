PORT=5000
NODE_ENV=development
# Optional locally. In production, set DATABASE_URL and DB_SSL_MODE.
DATABASE_URL=
DB_SSL_MODE=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=repo-ai
DB_USER=postgres
DB_PASSWORD=

# Local CORS remains permissive. Set the exact HTTPS frontend origin in production.
CORS_ORIGIN=http://localhost:5173
# Defaults to backend/repositories locally. On Render, mount a persistent disk here.
# REPOSITORY_STORAGE_PATH=

# Required only for real embedding generation and semantic search.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.8-flash
MAX_CONTEXT_CHARS=24000
